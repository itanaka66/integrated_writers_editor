POSTGRES_DB=writers
POSTGRES_USER=writers
POSTGRES_PASSWORD=writers
ADMIN_PASSWORD=writers
DATABASE_URL=postgresql+psycopg2://writers:writers@db:5432/writers
QDRANT_URL=http://qdrant:6333
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
# Auto-write's Controller (planning/quality-gate) model. Can point at the
# same Ollama server as OLLAMA_URL with a different model, or at a second
# Ollama server entirely (e.g. a separate GPU).
CONTROLLER_OLLAMA_URL=http://host.docker.internal:11434
CONTROLLER_OLLAMA_MODEL=qwen3:14b
CORS_ORIGINS=http://localhost:3000
# Optional: episode text is always mirrored to disk (writers_STORAGE_DIR,
# defaults to a container-local volume). Set GIT_REMOTE_URL to also
# auto-commit and push that mirror to a git remote on a timer. Embed your
# token in the URL the way git expects it, e.g.:
#   https://<personal-access-token>@github.com/<you>/<repo>.git
# Leave unset to keep the local-disk mirror without any GitHub sync.
GIT_REMOTE_URL=
GIT_AUTOSYNC_INTERVAL_SECONDS=300
# Optional: scheduled backups (PostgreSQL dump + Qdrant snapshot) on a
# timer, written to a container volume (BACKUP_DIR). Off by default — set
# BACKUP_ENABLED=true to turn it on. You can also trigger one on demand
# any time from 設定 > バックアップ, or run scripts/backup.sh by hand.
BACKUP_ENABLED=false
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_COUNT=7
