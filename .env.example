POSTGRES_DB=writers
POSTGRES_USER=writers
POSTGRES_PASSWORD=writers
ADMIN_PASSWORD=writers
# DATABASE_URL is built automatically from POSTGRES_DB/USER/PASSWORD above
# for the bundled `db` container — leave it unset. Only set DATABASE_URL
# here if you're pointing at a PostgreSQL instance outside this Compose
# project (it then overrides the auto-built value entirely).
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
# QDRANT_URL defaults to the bundled `qdrant` container. Only set it here
# if you're pointing at a Qdrant instance outside this Compose project.
# QDRANT_URL=http://host:6333
# Defaults to an Ollama already running on the Docker host (install it
# separately from https://ollama.com). To use the bundled `ollama`
# container instead, run `docker compose up` with `ollama` included in
# the service list (scripts/setup.sh asks) and set this to
# http://ollama:11434 — models must then be pulled into that container,
# e.g. `docker compose exec ollama ollama pull qwen3:8b`.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
# Cloud AI providers (Anthropic Claude, OpenAI, Google Gemini) are configured
# at runtime from 設定 > 接続設定 in the app, not via env vars.
# Origins allowed to call the API from a browser. Defaults to "*" (any
# origin) so the app works out of the box no matter what host/IP/domain you
# access it from — the API is already protected by its own Basic Auth
# admin password, so this isn't opening up anything that wasn't already
# behind a login. To restrict it to specific origins instead, set a
# comma-separated list (e.g. https://myapp.example.com,https://admin.example.com)
# — this must then include whatever origin the web frontend is actually
# served from, or the browser will block API calls from it.
CORS_ORIGINS=*
# The URL your browser uses to reach the API. If you access the web app
# from anywhere other than the Docker host itself (a LAN IP, a cloud VM's
# public address, a domain), this MUST be that address's :8000/api/v1, not
# localhost — "localhost" in the browser always means the visitor's own
# computer. A `docker compose up` (recreate) after changing this is enough
# to apply it — no image rebuild needed.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Optional: episode text is always mirrored to disk (writers_STORAGE_DIR,
# defaults to a container-local volume). Set GIT_REMOTE_URL to also
# auto-commit and push that mirror to a git remote on a timer. Embed your
# token in the URL the way git expects it, e.g.:
#   https://<personal-access-token>@github.com/<you>/<repo>.git
# Leave unset to keep the local-disk mirror without any GitHub sync.
GIT_REMOTE_URL=
GIT_AUTOSYNC_INTERVAL_SECONDS=300
# Optional: scheduled backups (PostgreSQL dump + Qdrant snapshot) on a
# timer, written to a container volume (BACKUP_DIR). Off by default — set
# BACKUP_ENABLED=true to turn it on. You can also trigger one on demand
# any time from 設定 > バックアップ, or run scripts/backup.sh by hand.
BACKUP_ENABLED=false
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_COUNT=7
# Optional: "Sign in with Google/GitHub" OAuth2 login, alongside the Basic
# Auth admin/user-management login above (it keeps working either way).
# All of the following must be set for either provider to actually turn on
# (a warning is logged at startup if that's only partially done).
#
# PUBLIC_BASE_URL is the exact externally-reachable origin your browser
# uses to reach this app (e.g. https://writer.example.com) — it's used to
# build each provider's callback URL below, which must be registered with
# that provider EXACTLY (including scheme and no trailing slash).
# PUBLIC_BASE_URL=https://writer.example.com
# SESSION_SECRET signs the login session cookie — generate a long random
# value once (e.g. `openssl rand -hex 32`) and keep it stable; rotating it
# logs everyone out.
# SESSION_SECRET=
# Google: register an OAuth 2.0 Client ID at
# https://console.cloud.google.com/apis/credentials (Web application) with
# authorized redirect URI {PUBLIC_BASE_URL}/api/v1/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GitHub: register an OAuth App at
# https://github.com/settings/developers with authorization callback URL
# {PUBLIC_BASE_URL}/api/v1/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Only set this to false for local http:// development — session cookies
# are Secure by default and browsers silently drop them over plain HTTP.
# SECURE_COOKIES=true
# Optional: outbound email for the "forgot password" flow (a locked-out user
# requests a reset link from the Login screen). Also requires SESSION_SECRET
# and PUBLIC_BASE_URL above to be set (they sign and build the reset link) —
# without those two, password-reset requests are silently skipped. Without
# SMTP_HOST set, the request endpoint still responds normally but no email
# is actually sent (a warning is logged).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com
# SMTP_USE_TLS=true
