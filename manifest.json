{
  "schema": 2,
  "required_executas": [
    {
      "tool_id": "bundled:integrated-writers-editor",
      "min_version": "0.1.0",
      "version": "latest"
    }
  ],
  "tags": ["integrated-writers-editor"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "Integrated Writers Editor",
        "default": true,
        "default_size": { "w": 640, "h": 480 },
        "min_size": { "w": 320, "h": 240 }
      }
    ],
    "host_api": {
      "tools": ["required:bundled:integrated-writers-editor"],
      "storage": ["get", "set"],
      "window": ["set_title", "ready"]
    },
    "csp_overrides": {},
    "state_merge": "last_writer_wins"
  }
}